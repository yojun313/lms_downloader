# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 git에 올라가지 않습니다)

# OpenAI API 키 (필수) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 전사 모델: whisper-1(타임스탬프 포함, 기본) | gpt-4o-transcribe | gpt-4o-mini-transcribe
OPENAI_STT_MODEL=whisper-1

# 앱 언어 드롭다운의 기본값. auto=자동 감지, 또는 ko/en/ja/zh/fr/de/es/it/pt/ru/ar/hi/th/vi/id
# (앱에서 드롭다운을 바꾸면 그 값이 우선)
STT_LANGUAGE=auto
