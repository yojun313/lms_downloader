# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 git에 올라가지 않습니다)

# 어떤 STT API를 쓸지: openai | custom
STT_PROVIDER=custom

# 전사 언어 코드 (ko/en/ja/zh/fr/de/es/it/pt/ru/ar/hi/th/vi/id)
STT_LANGUAGE=ko

# ---- STT_PROVIDER=openai 일 때 ----
OPENAI_API_KEY=
# whisper-1(타임스탬프 포함) | gpt-4o-transcribe | gpt-4o-mini-transcribe
OPENAI_STT_MODEL=whisper-1

# ---- STT_PROVIDER=custom 일 때 (매니저앱 whisper API) ----
# 매니저앱 /token 값
CUSTOM_STT_TOKEN=
CUSTOM_STT_URL=https://manager.knpu.re.kr/api/analysis/whisper
# 1=small(빠름), 2=medium(권장), 3=large(정확)
CUSTOM_STT_MODEL=2
