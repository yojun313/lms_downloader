# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 git에 올라가지 않습니다)
# STT 엔진(커스텀 / OpenAI)과 언어는 앱 옵션에서 고릅니다. 여기에는 키/토큰만 둡니다.

# ---- 커스텀 Whisper API (매니저앱) ----
# 매니저앱 /token 값  (LecAI .env 의 AUDIO_LLM_TOKEN / CUSTOM_TOKEN 이름도 인식)
CUSTOM_STT_TOKEN=
CUSTOM_STT_URL=https://manager.knpu.re.kr/api/analysis/whisper
# 실시간(NDJSON) 전사 라우트. 비우면 CUSTOM_STT_URL + "/stream". 있으면 우선 사용하고, 404 면 아래 일괄 방식으로 자동 폴백
CUSTOM_STT_STREAM_URL=
# (일괄 방식용) 진행상황 서버 — 전사 전에 pid 를 등록해야 GPU 서버가 정상 동작함
CUSTOM_STT_PROGRESS_URL=https://manager.knpu.re.kr/progress
# 1=small(빠름), 2=medium(권장), 3=large(정확)
CUSTOM_STT_MODEL=2

# ---- OpenAI 공식 API ----
# https://platform.openai.com/api-keys  (사용량 과금이므로 긴 강의는 커스텀 권장)
OPENAI_API_KEY=
# whisper-1(타임스탬프 포함, 기본) | gpt-4o-transcribe | gpt-4o-mini-transcribe
OPENAI_STT_MODEL=whisper-1

# ---- 공통 ----
# 앱 언어 드롭다운의 초기 기본값. auto=자동 감지, 또는 ko/en/ja/zh/fr/de/es/it/pt/ru/ar/hi/th/vi/id
STT_LANGUAGE=auto
